# =============================================================================
# Internal Task Service — .gitignore
# Based on github/gitignore/Python.gitignore, trimmed and project-specific.
# =============================================================================

# -----------------------------------------------------------------------------
# Byte-compiled / optimised / dynamic-link
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# -----------------------------------------------------------------------------
# Distribution / packaging
# -----------------------------------------------------------------------------
.Python
build/
dist/
*.egg-info/
*.egg
MANIFEST
pip-wheel-metadata/
share/python-wheels/
*.manifest
*.spec

# -----------------------------------------------------------------------------
# Virtualenvs (uv writes to .venv/ by default)
# -----------------------------------------------------------------------------
.venv/
venv/
env/
ENV/
.python-version.local

# -----------------------------------------------------------------------------
# Test / coverage artifacts
# -----------------------------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.cache/
.tox/
.nox/
nosetests.xml
*.cover
*.py,cover
.hypothesis/

# -----------------------------------------------------------------------------
# Static analysis caches
# -----------------------------------------------------------------------------
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/

# -----------------------------------------------------------------------------
# Environment files (only .env.example is checked in — FRD §6.1)
# -----------------------------------------------------------------------------
.env
.env.local
.env.dev
.env.test
.env.qa
.env.prod
.env.*.local

# -----------------------------------------------------------------------------
# Hurl / Schemathesis reports
# -----------------------------------------------------------------------------
reports/
!reports/.gitkeep
!reports/hurl/.gitkeep

# -----------------------------------------------------------------------------
# Logs and runtime artifacts
# -----------------------------------------------------------------------------
*.log
logs/
*.pid
*.sock

# -----------------------------------------------------------------------------
# Docker
# -----------------------------------------------------------------------------
docker-compose.override.yaml
docker-compose.override.yml

# -----------------------------------------------------------------------------
# Editors / IDEs
# -----------------------------------------------------------------------------
.idea/
.vscode/
!.vscode/extensions.json
!.vscode/settings.json.example
*.swp
*.swo
*~
.history/

# -----------------------------------------------------------------------------
# Jupyter / notebooks (in case anyone scratches)
# -----------------------------------------------------------------------------
.ipynb_checkpoints/
*.ipynb

# -----------------------------------------------------------------------------
# OS artifacts
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# -----------------------------------------------------------------------------
# Direnv / mise / asdf
# -----------------------------------------------------------------------------
.envrc
.tool-versions.local

# -----------------------------------------------------------------------------
# Secrets — extra belt-and-braces, never check these in
# -----------------------------------------------------------------------------
*.pem
*.key
*.crt
secrets/
.secrets/

.history

# devt agent persistent memory (per-project)
.claude/agent-memory/

# devt memory FTS5 index (regenerable from markdown)
.devt/memory/index.db

# devt memory auto-index debounce marker (transient)
.devt/memory/.auto-index-stamp

# devt candidate-surfacing markers (transient — a bare timestamp and a counter the plugin
# rewrites as it runs, so tracking them dirties the tree on every session)
.devt/memory/.last-candidate-surface
.devt/memory/.last-candidate-escalation

# devt memory export bundles (transient — share via explicit channel)
.devt/memory/export-*.json

# Graphify ephemeral cache
graphify-out/cache/

# Graphify per-machine manifest
graphify-out/manifest.json

# claude-mem local session DB
.claude-mem/mem.db

# Claude Code per-machine settings
.claude/settings.local.json

# Graphify regenerable artifacts + per-machine pointers. All of these are rewritten wholesale by
# every `/graphify update .`, so tracking them made each refresh a several-hundred-line diff of
# machine-written text with no reviewable change in it (and the first two exceed the pre-commit
# size limit). Saved query answers under graphify-out/memory/ stay tracked — authored once, not
# rebuilt.
graphify-out/graph.json
graphify-out/graph.html
graphify-out/GRAPH_REPORT.md
graphify-out/cost.json
graphify-out/.graphify_labels.json
graphify-out/.graphify_python
graphify-out/.graphify_root

# devt workflow state (recursive — catches sub-tree devt invocations)
**/.devt/state/

# devt MCP tool-call trace (recursive)
**/.devt/memory/_mcp-trace.jsonl
