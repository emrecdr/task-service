# Task Service — reference environment template.
# Copy this file to .env.<APP_ENV> and replace placeholders. Never commit real values.

APP_ENV=dev
PROJECT_NAME=Task Service
API_PREFIX=/v1
DATABASE_URL=postgresql+asyncpg://taskservice:taskservice@localhost:5432/taskservice
LOG_LEVEL=

# Request hardening (all optional — sane defaults apply when unset).
# CORS allow-list as a JSON array; empty (default) leaves CORS off entirely.
CORS_ALLOW_ORIGINS=[]
# Reject request bodies larger than this many bytes (default 1 MiB).
MAX_REQUEST_BODY_BYTES=1048576
# Wall-clock budget per request before a 504 is returned (default 30s).
REQUEST_TIMEOUT_SECONDS=30.0

# Async DB connection pool, per worker (defaults = SQLAlchemy QueuePool defaults).
# Lower these for high WEB_CONCURRENCY so ~(size+overflow)*workers stays under Postgres
# max_connections. DB_POOL_RECYCLE_SECONDS=-1 disables age-based recycling.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=-1
# Server-enforced DB timeouts (kept under REQUEST_TIMEOUT_SECONDS so saturation fails fast → 503).
# DB_STATEMENT_TIMEOUT_MS / DB_LOCK_TIMEOUT_MS = 0 disables the Postgres GUC.
DB_STATEMENT_TIMEOUT_MS=10000
DB_LOCK_TIMEOUT_MS=5000
DB_POOL_TIMEOUT_SECONDS=5.0
